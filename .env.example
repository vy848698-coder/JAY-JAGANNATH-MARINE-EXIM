# Environment variables for the enquiry relay (api/enquiry.js).
# Set these in the Vercel project: Settings → Environment Variables.
# They are read server-side only and never reach the browser, so do NOT
# prefix them with NEXT_PUBLIC_ or anything similar.

# Where the dashboard is reachable, with no trailing slash.
# The relay posts to <DASHBOARD_URL>/api/public/enquiries.
DASHBOARD_URL=https://dashboard.example.com

# Must match INTAKE_KEY in the dashboard's own .env exactly.
INTAKE_KEY=

# For local testing against a dashboard running on your machine, use:
#   DASHBOARD_URL=http://localhost:4000
